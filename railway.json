{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && cargo build --release"
  },
  "deploy": {
    "startCommand": "cd backend && ./target/release/pesatext_backend",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE"
  }
}